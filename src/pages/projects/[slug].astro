---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import { getPublishedProjects, toProjectRecord } from '../../lib/projects';
import { resolveProject, t } from '../../lib/i18n';

const locale = 'en' as const;

/*
  One page per published project, built ahead of time.

  The runtime 404 this route used to fall back to is gone with the server: a
  slug that has no file simply has no page, and the static host answers with
  404.html on its own.
*/
export async function getStaticPaths() {
  const entries = await getPublishedProjects();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { record: toProjectRecord(entry) },
  }));
}

const { record } = Astro.props;
const project = resolveProject(record, locale);
const strings = t(locale);
const pageTitle = `${project.title} | ${strings.projects.caseStudy}`;
const metaDescription = project.summary || project.description || project.title;
---

<Layout locale={locale} title={pageTitle} description={metaDescription}>
  <Nav locale={locale} />
  <CaseStudy locale={locale} project={{ ...project, gallery: record.gallery }} />
  <Footer locale={locale} />
</Layout>
